table fact_subscription
	lineageTag: 280b8afd-0d40-4fa8-91cf-0db1b8bbeed6

	measure 'Total MRR' = SUM(fact_subscription[mrr])
		formatString: \$#,0.00
		lineageTag: 9d4de1fd-25c0-4320-8c6d-1618528d8611

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Active Accounts' = ```
			
			 VAR LastMonth = CALCULATE(MAX(fact_subscription[month]), REMOVEFILTERS(DimDate))
			 RETURN CALCULATE(SUM(fact_subscription[active]), REMOVEFILTERS(DimDate), fact_subscription[month] = LastMonth)
			```
		formatString: #,0
		lineageTag: d73207d7-74e5-4aea-95aa-4f998df58115

	measure 'Latest NRR' = ```
			
			 VAR LastMonth = CALCULATE(MAX(fact_subscription[month]), REMOVEFILTERS(DimDate))
			 RETURN CALCULATE(DIVIDE(SUM(fact_subscription[retained_mrr]), SUM(fact_subscription[previous_mrr])), REMOVEFILTERS(DimDate), fact_subscription[month] = LastMonth)
			```
		formatString: 0.00%
		lineageTag: efce87f9-8eb8-432c-b2e5-c7193feebb72

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Logo Churn' = ```
			
			 VAR LastMonth = CALCULATE(MAX(fact_subscription[month]), REMOVEFILTERS(DimDate))
			 RETURN CALCULATE(DIVIDE(SUM(fact_subscription[churned]), SUM(fact_subscription[starting_active])), REMOVEFILTERS(DimDate), fact_subscription[month] = LastMonth)
			```
		formatString: 0.00%
		lineageTag: 07a09843-cb85-4ad1-924b-3fcbba908598

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest ARPA' = DIVIDE([Latest Month MRR], [Latest Active Accounts])
		formatString: \$#,0.00
		lineageTag: 9e14ef82-c6a8-45b6-a546-d69f976c4bcd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

